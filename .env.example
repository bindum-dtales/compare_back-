# development (default) or production. Set NODE_ENV=production on the server.
# NODE_ENV=production
PORT=4000
# Interface to bind. Unset: all interfaces. Behind Nginx on the same host: 127.0.0.1.
# HOST=127.0.0.1

# CORS allow-list: comma-separated exact origins (scheme://host[:port], no path, no "*").
# Only browsers calling this API cross-origin need an entry. The frontend's /api proxy is
# same-origin, so production can leave this unset (default there: none; in development:
# http://localhost:3000). If the frontend calls the API directly (NEXT_PUBLIC_API_BASE_URL):
# FRONTEND_URL=https://score.dtales.tech
FRONTEND_URL=http://localhost:3000

# Server-only. Never expose the service-role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Jina Reader (website fetching) works without a key at ~20 req/min; a key raises the limit.
# JINA_API_KEY=

# Competitor discovery (search). Required for research jobs to get past category detection.
TAVILY_API_KEY=
# Category detection + competitor classification (LLM). Required for research jobs.
GROQ_API_KEY=
# Must support strict structured outputs on Groq (openai/gpt-oss-20b, openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# Not used yet.
# EXA_API_KEY=
# ANTHROPIC_API_KEY=
# TOGETHER_API_KEY=
